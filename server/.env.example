# Required — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string
# Local: mongodb://localhost:27017/truthcheck
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/truthcheck
MONGODB_URI=mongodb://localhost:27017/truthcheck

# Search grounding — pick one (optional but improves accuracy a lot)
# Tavily (preferred): https://tavily.com — free tier available
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# Serper (alternative): https://serper.dev — free tier available
# SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server port (default: 5001)
PORT=5001

# CORS origin for web client
CLIENT_ORIGIN=http://localhost:5173

# ─── Firebase Cloud Messaging (Push Notifications) ──────────────────────────
# Required ONLY for push notifications to the mobile app.
# Leave empty to run without push notifications (everything else still works).
#
# Steps to get these values:
#   1. Go to https://console.firebase.google.com
#   2. Create a project (or use existing)
#   3. Project Settings → Service Accounts → Generate new private key
#   4. Copy values from the downloaded JSON file
#
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Note: Keep FIREBASE_PRIVATE_KEY in quotes. Leave \n as literal \n — server converts them.
